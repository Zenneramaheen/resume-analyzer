# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/resume_analyzer
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: enables AI-enriched feedback via OpenAI. Leave empty to use the
# built-in heuristic analyzer only.
OPENAI_API_KEY=
